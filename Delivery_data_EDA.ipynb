      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Discount_Applied\n",
            "0.0        0.000000\n",
            "20.0      20.000000\n",
            "50.0      50.000000\n",
            "100.0    100.000000\n",
            "300.0    296.413267\n",
            "Name: Price_Reduction, dtype: float64\n"
          ]
        }
      ],
      "source": [
        "df[\"Price_Reduction\"] = df[\"Order_Value\"] - df[\"Final_Amount\"]\n",
        "impact = df.groupby(\"Discount_Applied\")[\"Price_Reduction\"].mean()\n",
        "print(impact)\n"
      ]
    },
