        "def group_distance(x):\n",
        "  if x <= 5:\n",
        "    return \"1-5\"\n",
        "  elif x <= 10:\n",
        "    return \"6-10\"\n",
        "  elif x <= 15:\n",
        "    return \"11-15\"\n",
        "  elif x <= 20:\n",
        "    return \"16-20\"\n",
        "  elif x <= 25:\n",
        "    return \"21-25\"\n",
        "  elif x <= 30:\n",
        "    return \"26-30\"\n",
        "  elif x <= 35:\n",
        "    return \"31-35\"\n",
        "  elif x <= 40:\n",
        "    return \"36-40\"\n",
        "\n",
        "df[\"Distance_Group\"] = df[\"Distance_km\"].apply(group_distance)\n",
        "delay = df.groupby(\"Distance_Group\")[\"Delivery_Time_Min\"].mean()\n"
